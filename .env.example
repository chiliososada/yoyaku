# ============================================================================
# booking-saas 環境変数サンプル
# このファイルを .env にコピーして値を設定してください: cp .env.example .env
# ============================================================================

# ---- アプリケーション ----
NODE_ENV=development
# 公開URL（予約完了メール/キャンセルリンク生成に使用）
APP_BASE_URL=http://localhost:3000
# 全システムの基準タイムゾーン（表示用）。保存はすべてUTC。
APP_TIMEZONE=Asia/Tokyo

# ---- データベース (PostgreSQL) ----
# docker compose の postgres サービスと一致させること
POSTGRES_USER=booking
POSTGRES_PASSWORD=booking_local_pw
POSTGRES_DB=booking_saas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prisma 接続文字列（アプリ実行用・コネクションプール経由）
DATABASE_URL="postgresql://booking:booking_local_pw@localhost:5432/booking_saas?schema=public&connection_limit=20"
# マイグレーション/シャドウDB用（任意。未設定なら DATABASE_URL を使用）
DIRECT_URL="postgresql://booking:booking_local_pw@localhost:5432/booking_saas?schema=public"

# ---- Redis (キュー/キャッシュ/分散ロック) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"

# ---- 認証 (Auth.js / NextAuth v5) ----
# `openssl rand -base64 32` で生成
AUTH_SECRET="please-change-me-to-a-32byte-random-secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# ---- エラー監視 (Sentry — 予約枠 / 未設定なら無効) ----
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---- 決済 (Stripe — 予約枠 / 将来拡張) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- 通知 (将来拡張: LINE / Email / SMS) ----
# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# SMTP (Email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="予約システム <noreply@example.com>"
# SMS (例: Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- ジョブワーカー ----
QUEUE_CONCURRENCY=5
